# =============================================================================
# EEF Platform - Environment Configuration
# Copy this file to .env and adjust values as needed.
# NEVER commit a real .env file with production secrets.
# =============================================================================

ENV=development
DEBUG=true

# --- Database ---
# Local runnable setting for development without Docker services:
DATABASE_URL=sqlite:///./eef_demo.db
# Docker version (if running docker compose):
# DATABASE_URL=postgresql+psycopg2://eef:eef_dev_password@postgres:5432/eef

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=eef_neo4j_password
NEO4J_ENABLED=false

# --- Auth / Security ---
# Generate a strong random value for production, e.g.: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING_BEFORE_ANY_REAL_DEPLOYMENT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI Identity Copilot (optional external LLM) ---
# Leave blank to use the built-in deterministic, tool-grounded template engine.
LLM_API_KEY=
LLM_PROVIDER=none

# --- AI / Models ---
MODEL_DEVICE=cpu

# --- Uploads ---
UPLOAD_DIRECTORY=/eef/backend/uploads
MAX_UPLOAD_SIZE=15728640

# --- CORS ---
# Local development + hosted Vercel frontend
# Example production value: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080,https://your-app.vercel.app
