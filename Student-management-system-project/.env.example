# Copy this file to .env for local development and fill in real values.
# Never commit the real .env file - it's already in .gitignore.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database (Neon Postgres connection string).
# Leave unset locally to fall back to a local sqlite file automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
